{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lgu.bettergov.ph/schemas/research-run-manifest.schema.json",
  "title": "Research run manifest",
  "description": "Audit record of one refresh run under research/runs/<run-id>/manifest.json.",
  "type": "object",
  "required": ["runId", "startedAt", "parameters", "sources"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "description": "Manifest format version. Absent means v1 legacy (still readable).",
      "minimum": 1
    },    "runId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]+)?$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "parameters": {
      "type": "object",
      "description": "Run filters and options (source, domain, due-only, fixture use).",
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "checkedAt", "outcome"],
        "properties": {
          "sourceId": { "type": "string" },
          "checkedAt": { "type": "string", "format": "date-time" },
          "outcome": {
            "type": "string",
            "enum": ["collected", "unchanged", "unavailable", "failed", "skipped", "unregistered"]
          },
          "error": { "type": "string" },
          "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "candidatesProduced": { "type": "integer", "minimum": 0 },
    "conflictsFound": { "type": "integer", "minimum": 0 },
    "collectedBy": { "type": "string" }
  },
  "additionalProperties": false
}
