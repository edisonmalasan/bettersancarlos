{
  "name": "bettersancarlos-web",
  "version": "1.1.20",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "serve": "npx serve -s out -p 8000",
    "serve:dist": "npx serve -s out -p 8080",
    "data:validate": "bun run scripts/data/validate.ts",
    "data:refresh": "bun run scripts/data/refresh.ts",
    "data:diff": "bun run scripts/data/diff.ts",
    "data:generate": "bun run scripts/data/generate.ts",
    "data:promote": "bun run scripts/data/promote.ts",
    "data:ingest-facebook": "bun run scripts/data/ingest-facebook.ts",
    "data:report": "bun run scripts/data/report.ts",
    "data:test": "bun test scripts/data scripts/sync-facebook.test.js",
    "research:validate": "bun run scripts/research/validate.ts",
    "research:index": "bun run scripts/research/index.ts",
    "research:index:check": "bun run scripts/research/index.ts --check",
    "research:test": "bun test scripts/research",
    "verify": "tsc --noEmit && bun run data:validate && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@lordicon/react": "^1.11.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.28",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
